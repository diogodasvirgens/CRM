// Backend reduzido só ao que o WhatsApp bridge (Baileys) precisa tocar
// direto no banco. Lead, Stage, Tag, EventEdition, LeadTag e LeadHistory
// não são mais modelados aqui — o frontend fala direto com o Supabase
// (RLS + funções RPC) pra essas tabelas, então o Prisma Client deste
// backend não precisa (nem deve) saber delas.
//
// leadId (em Message) e currentLeadId (em Contact) continuam existindo no
// banco como antes, só que aqui viram campos soltos em vez de relação
// tipada, já que o model Lead não existe mais neste schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// MessageDirection: IN | OUT
// MessageMediaType: image | audio | video | document | sticker

// Espelha só os campos que o backend precisa ler de public.profiles
// (a tabela de verdade é gerenciada pelo Supabase Auth + frontend).
model Profile {
  id     String  @id @db.Uuid
  name   String
  email  String  @unique
  role   String
  active Boolean @default(true)

  messagesSent Message[] @relation("MessageSender")

  @@map("profiles")
}

// Um contato do WhatsApp. Existe independente de lead (toda mensagem cria/usa
// um Contact) e pode virar lead mais de uma vez ao longo do tempo — por isso
// currentLeadId aponta pro lead atual (o que recebe as mensagens novas
// enquanto a conversa não for ligada a outro lead).
model Contact {
  id            String    @id @default(cuid())
  phone         String    @unique
  // JID exato pra rotear mensagens de resposta (ex.: "5584...@s.whatsapp.net").
  // O WhatsApp às vezes identifica um contato por LID em vez do número de
  // telefone real (@lid); nesse caso `phone` guarda o número real (resolvido
  // via remoteJidAlt) mas o envio precisa ir pro JID exato de onde a
  // conversa está acontecendo, não um reconstruído a partir do telefone.
  whatsappJid   String?
  name          String?
  archivedAt    DateTime?
  lastMessageAt DateTime?
  lastReadAt    DateTime?
  currentLeadId String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      Message[]
}

model Message {
  id                String   @id @default(cuid())
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId            String?
  content           String
  direction         String
  senderId          String?  @db.Uuid
  sender            Profile? @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  whatsappMessageId String?  @unique
  mediaType         String?
  mediaMimeType     String?
  mediaFileName     String?
  createdAt         DateTime @default(now())

  @@index([contactId])
  @@index([leadId])
}
