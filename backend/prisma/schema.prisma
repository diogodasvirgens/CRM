// Schema pensado para trocar o datasource "sqlite" por "postgresql" no futuro
// sem mudar o resto do código (Prisma abstrai a diferença de queries).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQLite não tem suporte nativo a enum no Prisma, por isso os "enums" abaixo
// são campos String validados na camada de aplicação (zod). Ao migrar para
// PostgreSQL, dá para promovê-los a `enum` de verdade sem tocar no restante.
//
// Role: GESTOR | ATENDENTE | FINANCEIRO
// BusinessLine: SHOW | EVENTO
// LeadOrigin: INDICACAO | REDES_SOCIAIS | RECORRENCIA | TRAFEGO_PAGO | OUTRO
// HistoryField: STAGE | OWNER
// MessageDirection: IN | OUT

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  passwordHash      String
  role              String
  active            Boolean  @default(true)
  mustChangePassword Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  leadsOwned        Lead[]        @relation("LeadOwner")
  historyChanges    LeadHistory[] @relation("HistoryChangedBy")
  messagesSent      Message[]     @relation("MessageSender")
}

// Um contato do WhatsApp. Existe independente de lead (toda mensagem cria/usa
// um Contact) e pode virar lead mais de uma vez ao longo do tempo — por isso
// a ligação com Lead é 1-para-muitos, e `currentLeadId` aponta pro lead atual
// (o que recebe as mensagens novas enquanto a conversa não for outro lead).
model Contact {
  id            String    @id @default(cuid())
  phone         String    @unique
  // JID exato pra rotear mensagens de resposta (ex.: "5584...@s.whatsapp.net").
  // O WhatsApp às vezes identifica um contato por LID em vez do número de
  // telefone real (@lid); nesse caso `phone` guarda o número real (resolvido
  // via remoteJidAlt) mas o envio precisa ir pro JID exato de onde a
  // conversa está acontecendo, não um reconstruído a partir do telefone.
  whatsappJid   String?
  name          String?
  archivedAt    DateTime?
  lastMessageAt DateTime?
  lastReadAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  leads         Lead[]    @relation("ContactLeads")
  currentLeadId String?   @unique
  currentLead   Lead?     @relation("ContactCurrentLead", fields: [currentLeadId], references: [id], onDelete: SetNull)
  messages      Message[]
}

model Message {
  id                String   @id @default(cuid())
  contactId         String
  contact           Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId            String?
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  content           String
  direction         String
  senderId          String?
  sender            User?    @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  whatsappMessageId String?  @unique
  createdAt         DateTime @default(now())

  @@index([contactId])
  @@index([leadId])
}

model Stage {
  id           String       @id @default(cuid())
  businessLine String
  name         String
  order        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  leads        Lead[]

  @@unique([businessLine, order])
}

model EventEdition {
  id          String   @id @default(cuid())
  name        String
  date        DateTime?
  location    String?
  ticketPrice Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads       Lead[]
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  leads     LeadTag[]
}

model Lead {
  id             String       @id @default(cuid())
  contactName    String
  contactId      String
  contact        Contact      @relation("ContactLeads", fields: [contactId], references: [id])
  currentForContact Contact?  @relation("ContactCurrentLead")
  businessLine   String
  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id])
  estimatedValue Float?
  eventDate      DateTime?
  eventType      String?
  location       String?
  ownerId        String?
  owner          User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  origin         String
  originDetail   String?
  notes          String?
  eventEditionId String?
  eventEdition   EventEdition? @relation(fields: [eventEditionId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tags           LeadTag[]
  history        LeadHistory[]
  messages       Message[]

  @@index([businessLine])
  @@index([stageId])
  @@index([ownerId])
  @@index([contactId])
}

model LeadTag {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model LeadHistory {
  id            String       @id @default(cuid())
  leadId        String
  lead          Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  field         String
  oldValue      String?
  newValue      String?
  changedById   String
  changedBy     User         @relation("HistoryChangedBy", fields: [changedById], references: [id])
  createdAt     DateTime     @default(now())
}
